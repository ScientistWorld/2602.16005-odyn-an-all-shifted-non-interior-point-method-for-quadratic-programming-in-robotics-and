# Apptainer definition file for the ODYN QP solver environment.

Bootstrap: docker
From: python:3.12-slim

%post
    apt-get update && apt-get install -y --no-install-recommends \
        tmux nano vim-tiny less curl wget git ca-certificates && \
    ln -sf /usr/bin/vim.tiny /usr/bin/vim && \
    rm -rf /var/lib/apt/lists/*

    mkdir -p /home/user/data
    chmod 755 /home/user

# Python packages are installed by environment/setup.sh, not here.

    # --- Frozen environment (11 packages) ---
    # Sources: 0 both, 0 overlay-only, 11 setup-only
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    uv pip install --system \
        '2' \  # setup
        'command' \  # setup
        'export' \  # setup
        'if' \  # setup
        'numpy' \  # setup
        'osqp' \  # setup
        'proxsuite' \  # setup
        'scipy' \  # setup
        'then' \  # setup
        'uv_break_system_packages' \  # setup
        'uv_system_python'  # setup

